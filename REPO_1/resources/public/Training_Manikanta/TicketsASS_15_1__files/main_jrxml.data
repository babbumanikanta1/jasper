		<parameter name="final_query" class="java.lang.String" evaluationTime="Early">
			<defaultValueExpression><![CDATA["WITH run_function AS ( " +
"    SELECT * FROM function_1() WHERE " + $P{Param_1} + " = 0 " +
"    UNION ALL " +
"    SELECT * FROM function_2(" + $P{Param_1} + ", '" + $P{Param_2} + "') WHERE 0 = 0 " +
") " +
"SELECT * FROM run_function"]]></defaultValueExpression>
		</parameter>
		<parameter name="Param_1" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
		</parameter>
		<parameter name="Param_2" class="java.lang.String" evaluationTime="Early">
			<defaultValueExpression><![CDATA["mani"]]></defaultValueExpression>
		</parameter>
		<queryString language="plsql">
			<![CDATA[WITH run_function AS (
    -- If id_param is 0, fetch from function_1
    SELECT * FROM function_1()
    WHERE $P{Param_1} = 0
    
    UNION ALL
    
    -- If id_param is NOT 0, execute function_2 and pass the parameters it needs
	
    SELECT * FROM function_2($P{Param_1}, $P{Param_2})
    WHERE $P{Param_1} != 0

	union all

	select * from function_3()
	where $P{Param_1}=-1
)
SELECT * FROM run_function;]]>
		</queryString>
