<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.jaspersoft.com/2007/SL/XMLSchema" version="1.3">
  <dataIslands>
    <itemGroup id="JoinTree_1" label="JoinTree_1" resourceId="JoinTree_1"></itemGroup>
  </dataIslands>
  <dataSources>
    <jdbcDataSource id="AuditDataSource">
      <schemaMap>
        <entry key="public">
          <string>public</string>
        </entry>
        <entry key="defaultSchema">
          <string></string>
        </entry>
      </schemaMap>
    </jdbcDataSource>
  </dataSources>
  <items>
    <item id="job_id" label="Job ID" resourceId="JoinTree_1.audit_properties_derived_table.job_id"></item>
    <item id="job_label" label="Job Name" resourceId="JoinTree_1.audit_properties_derived_table.job_label"></item>
    <item id="job_desc" label="Job Description" resourceId="JoinTree_1.audit_properties_derived_table.job_desc"></item>
    <item id="resource_name" label="Resource" resourceId="JoinTree_1.audit_properties_derived_table.resource_name"></item>
    <item id="relative_uri" label="URL" resourceId="JoinTree_1.relative_uri"></item>
    <item id="username" label="User" resourceId="JoinTree_1.jiauditevent.username"></item>
    <item id="organization_id" label="Organization ID" resourceId="JoinTree_1.audit_properties_derived_table.organization_id"></item>
    <item id="organization" label="Organization" resourceId="JoinTree_1.audit_properties_derived_table.organization"></item>
    <item id="start_time" label="Start Time" resourceId="JoinTree_1.audit_properties_derived_table.start_time"></item>
    <item id="completed_time" label="End Time" resourceId="JoinTree_1.audit_properties_derived_table.completed_time"></item>
    <item id="data_prep_time" label="Data Preparation Time (ms)" resourceId="JoinTree_1.audit_properties_derived_table.data_prep_time"></item>
    <item id="rpt_rendering_time" label="Report Fill Time (ms)" resourceId="JoinTree_1.audit_properties_derived_table.rpt_rendering_time"></item>
    <item id="execution_time" label="Run Time (ms)" resourceId="JoinTree_1.audit_properties_derived_table.execution_time"></item>
    <item id="exception_category" label="Execution Error Category" resourceId="JoinTree_1.audit_properties_derived_table.exception_category"></item>
    <item id="exception_message" label="Execution Error Message" resourceId="JoinTree_1.audit_properties_derived_table.exception_message"></item>
    <item id="notification_message" label="Notification Error Message" resourceId="JoinTree_1.audit_properties_derived_table.notification_message"></item>
    <item id="exception_stack_trace" label="Exception Stack Trace" resourceId="JoinTree_1.audit_properties_derived_table.exception_stack_trace"></item>
    <item id="notification_stack_trace" label="Notification Stack Trace" resourceId="JoinTree_1.audit_properties_derived_table.notification_stack_trace"></item>
    <item id="execution_ids" label="Execution ID(s)" resourceId="JoinTree_1.audit_properties_derived_table.execution_ids"></item>
    <item id="schedule_execution_id" label="Schedule ID" resourceId="JoinTree_1.audit_properties_derived_table.schedule_execution_id"></item>
  </items>
  <resources>
    <null id="constant_fields_level" datasourceId="AuditDataSource">
      <fieldList>
        <field id="orgpath" dataSetExpression="groovy('(tenant.getTenantFolderUri() == &quot;/&quot;) ? &quot;/&quot; : tenant.getTenantFolderUri() + &quot;/&quot;')" type="java.lang.String"></field>
        <field id="tenantUri" dataSetExpression="groovy('tenant.getTenantUri()')" type="java.lang.String"></field>
      </fieldList>
    </null>
    <jdbcTable id="jiauditevent" datasourceId="AuditDataSource" datasourceTableName="jiauditevent" schemaAlias="public">
      <fieldList>
        <field id="id" type="java.lang.Long"></field>
        <field id="username" type="java.lang.String"></field>
        <field id="tenant_id" type="java.lang.String"></field>
        <field id="event_date" type="java.sql.Timestamp"></field>
        <field id="resource_uri" type="java.lang.String"></field>
        <field id="resource_type" type="java.lang.String"></field>
        <field id="event_type" type="java.lang.String"></field>
        <field id="request_type" type="java.lang.String"></field>
      </fieldList>
      <filterString>event_type == 'runReport' and request_type == 'INTERNAL' and resource_type == 'ReportUnit'</filterString>
    </jdbcTable>
    <jdbcQuery id="audit_properties_derived_table" datasourceId="AuditDataSource">
      <fieldList>
        <field id="audit_event_id" type="java.lang.Long"></field>
        <field id="start_time" type="java.sql.Timestamp"></field>
        <field id="completed_time" type="java.sql.Timestamp"></field>
        <field id="execution_time" type="java.lang.String"></field>
        <field id="job_id" type="java.lang.String"></field>
        <field id="job_label" type="java.lang.String"></field>
        <field id="job_desc" type="java.lang.String"></field>
        <field id="data_prep_time" type="java.lang.String"></field>
        <field id="resource_name" type="java.lang.String"></field>
        <field id="organization" type="java.lang.String"></field>
        <field id="rpt_rendering_time" type="java.lang.String"></field>
        <field id="exception_category" type="java.lang.String"></field>
        <field id="exception_message" type="java.lang.String"></field>
        <field id="exception_stack_trace" type="java.lang.String"></field>
        <field id="notification_message" type="java.lang.String"></field>
        <field id="notification_stack_trace" type="java.lang.String"></field>
        <field id="organization_id" type="java.lang.String"></field>
        <field id="execution_ids" type="java.lang.String"></field>
        <field id="schedule_execution_id" type="java.lang.String"></field>
        <field id="organization_uri" type="java.lang.String"></field>
      </fieldList>
      <filterString>job_id != NULL</filterString>
      <query>SELECT t.audit_event_id
        , MAX(CASE WHEN t.property_type = 'scheduleStartTime' THEN to_timestamp(cast(cast(t.value as bigint)/1000 as bigint)) END) start_time
        , MAX(CASE WHEN t.property_type = 'scheduleEndTime' THEN to_timestamp(cast(cast(t.value as bigint)/1000 as bigint)) END) completed_time
        , MAX(CASE WHEN t.property_type = 'executionTime' THEN t.value END) execution_time
        , MAX(CASE WHEN t.property_type = 'jobID' THEN t.value END) job_id
        , MAX(CASE WHEN t.property_type = 'jobLabel' THEN t.value END) job_label
        , MAX(CASE WHEN t.property_type = 'jobDescription' THEN t.value END) job_desc
        , MAX(CASE WHEN t.property_type = 'executionIDS' THEN t.value END) execution_ids
        , MAX(CASE WHEN t.property_type = 'reportScheduleExecutionID' THEN t.value END) schedule_execution_id
        , MAX(CASE WHEN t.property_type = 'dataPrepTime' THEN t.value END) data_prep_time
        , MAX(CASE WHEN t.property_type = 'resourceName' THEN t.value END) resource_name
        , MAX(CASE WHEN t.property_type = 'organization' THEN t.value END) organization
        , MAX(CASE WHEN t.property_type = 'organizationID' THEN t.value END) organization_id
        , MAX(CASE WHEN t.property_type = 'reportRenderingTime' THEN t.value END) rpt_rendering_time
        , MAX(CASE WHEN t.property_type = 'exceptionCategory' THEN t.value END) exception_category
        , MAX(CASE WHEN t.property_type = 'exception' THEN t.value END) exception_message
		, MAX(CASE WHEN t.property_type = 'organizationURI' THEN t.value END) organization_uri
        , MAX(CASE WHEN t.property_type = 'exception' THEN t.clob_value END) exception_stack_trace
        , MAX(CASE WHEN t.property_type = 'notificationException' THEN t.value END) notification_message
        , MAX(CASE WHEN t.property_type = 'notificationException' THEN t.clob_value END) notification_stack_trace
        FROM jiauditeventproperty t
        where audit_event_id in (select distinct(p.audit_event_id) from jiauditeventproperty as p where
        p.property_type in ('exception','notificationException'))
        and audit_event_id in (select distinct(p.audit_event_id) from jiauditeventproperty as p where
        p.property_type in ('reportScheduleExecutionID'))
        group by t.audit_event_id</query>
    </jdbcQuery>
    <jdbcQuery id="JoinTree_1" datasourceId="AuditDataSource">
      <fieldList>
        <field id="jiauditevent.id" type="java.lang.Long"></field>
        <field id="jiauditevent.username" type="java.lang.String"></field>
        <field id="jiauditevent.tenant_id" type="java.lang.String"></field>
        <field id="jiauditevent.event_date" type="java.sql.Timestamp"></field>
        <field id="jiauditevent.resource_uri" type="java.lang.String"></field>
        <field id="jiauditevent.resource_type" type="java.lang.String"></field>
        <field id="jiauditevent.event_type" type="java.lang.String"></field>
        <field id="jiauditevent.request_type" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.audit_event_id" type="java.lang.Long"></field>
        <field id="audit_properties_derived_table.start_time" type="java.sql.Timestamp"></field>
        <field id="audit_properties_derived_table.completed_time" type="java.sql.Timestamp"></field>
        <field id="audit_properties_derived_table.execution_time" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.job_id" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.job_label" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.job_desc" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.data_prep_time" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.resource_name" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.organization" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.rpt_rendering_time" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.exception_category" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.exception_message" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.exception_stack_trace" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.notification_message" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.notification_stack_trace" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.organization_id" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.execution_ids" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.schedule_execution_id" type="java.lang.String"></field>
        <field id="audit_properties_derived_table.organization_uri" type="java.lang.String"></field>
        <field id="filter1" dataSetExpression="startsWith(audit_properties_derived_table.organization_uri, constant_fields_level.tenantUri)" type="java.lang.Boolean"></field>
        <field id="relative_uri" dataSetExpression="if(startsWith(jiauditevent.resource_uri, '/public/'), jiauditevent.resource_uri, concat('/', substr(jiauditevent.resource_uri, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String"></field>
      </fieldList>
      <filterString>jiauditevent.event_type == 'runReport' and jiauditevent.request_type == 'INTERNAL' and filter1 == true and audit_properties_derived_table.job_id != null and jiauditevent.resource_type == 'ReportUnit'</filterString>
      <joinInfo alias="audit_properties_derived_table" referenceId="audit_properties_derived_table"></joinInfo>
      <joinList>
        <join expr="audit_properties_derived_table.audit_event_id == jiauditevent.id" left="audit_properties_derived_table" right="jiauditevent" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <query>SELECT t.audit_event_id
        , MAX(CASE WHEN t.property_type = 'scheduleStartTime' THEN to_timestamp(cast(cast(t.value as bigint)/1000 as bigint)) END) start_time
        , MAX(CASE WHEN t.property_type = 'scheduleEndTime' THEN to_timestamp(cast(cast(t.value as bigint)/1000 as bigint)) END) completed_time
        , MAX(CASE WHEN t.property_type = 'executionTime' THEN t.value END) execution_time
        , MAX(CASE WHEN t.property_type = 'jobID' THEN t.value END) job_id
        , MAX(CASE WHEN t.property_type = 'jobLabel' THEN t.value END) job_label
        , MAX(CASE WHEN t.property_type = 'jobDescription' THEN t.value END) job_desc
        , MAX(CASE WHEN t.property_type = 'executionIDS' THEN t.value END) execution_ids
        , MAX(CASE WHEN t.property_type = 'reportScheduleExecutionID' THEN t.value END) schedule_execution_id
        , MAX(CASE WHEN t.property_type = 'dataPrepTime' THEN t.value END) data_prep_time
        , MAX(CASE WHEN t.property_type = 'resourceName' THEN t.value END) resource_name
        , MAX(CASE WHEN t.property_type = 'organization' THEN t.value END) organization
        , MAX(CASE WHEN t.property_type = 'organizationID' THEN t.value END) organization_id
        , MAX(CASE WHEN t.property_type = 'reportRenderingTime' THEN t.value END) rpt_rendering_time
        , MAX(CASE WHEN t.property_type = 'exceptionCategory' THEN t.value END) exception_category
        , MAX(CASE WHEN t.property_type = 'exception' THEN t.value END) exception_message
		, MAX(CASE WHEN t.property_type = 'organizationURI' THEN t.value END) organization_uri
        , MAX(CASE WHEN t.property_type = 'exception' THEN t.clob_value END) exception_stack_trace
        , MAX(CASE WHEN t.property_type = 'notificationException' THEN t.value END) notification_message
        , MAX(CASE WHEN t.property_type = 'notificationException' THEN t.clob_value END) notification_stack_trace
        FROM jiauditeventproperty t
        where audit_event_id in (select distinct(p.audit_event_id) from jiauditeventproperty as p where
        p.property_type in ('exception','notificationException'))
        and audit_event_id in (select distinct(p.audit_event_id) from jiauditeventproperty as p where
        p.property_type in ('reportScheduleExecutionID'))
        group by t.audit_event_id</query>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="audit_properties_derived_table" tableId="audit_properties_derived_table"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="jiauditevent" tableId="jiauditevent"></tableRef>
      </tableRefList>
    </jdbcQuery>
  </resources>
</schema>
