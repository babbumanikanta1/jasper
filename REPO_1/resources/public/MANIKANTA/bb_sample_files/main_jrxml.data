	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.ji.adhoc" value="1"/>
	<property name="com.jaspersoft.ji.adhoc.new" value="true"/>
	<property name="com.jaspersoft.jasperserver.adhoc.table.flattened.data.set" value="true"/>
	<parameter name="Parameter1" class="java.util.ArrayList" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.util.ArrayList(java.util.Arrays.asList(new String[]{"USA", "Canada","Mexico"}))]]></defaultValueExpression>
	</parameter>
	<parameter name="Count" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT *
FROM (
    SELECT
        c.country,
        c.fullname,
        SUM(s.store_sales) AS sales,
        ROW_NUMBER() OVER (
            PARTITION BY c.country
            ORDER BY SUM(s.store_sales) DESC
        ) rn
    FROM customer c
    JOIN sales_fact_1998 s
        ON c.customer_id = s.customer_id
       where 1=1 and  $X{IN, c.country, Parameter1}
    GROUP BY c.country, c.fullname
) x
WHERE rn <= $P{Count}]]>
	</queryString>
	<field name="country" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="country"/>
		<property name="com.jaspersoft.studio.field.label" value="country"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="customer"/>
	</field>
	<field name="fullname" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="fullname"/>
		<property name="com.jaspersoft.studio.field.label" value="fullname"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="customer"/>
	</field>
	<field name="sales" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="sales"/>
		<property name="com.jaspersoft.studio.field.label" value="sales"/>
	</field>
	<field name="rn" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="rn"/>
		<property name="com.jaspersoft.studio.field.label" value="rn"/>
	</field>
