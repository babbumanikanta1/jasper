	<subDataset name="Table Dataset" uuid="9a2a43a3-7e27-46bb-8c73-355f971b2096">
		<parameter name="Country" class="java.lang.String" isForPrompting="false"/>
		<parameter name="CountryIsNull" class="java.lang.Integer" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{Country} == null ? 1 : 0]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
	promotion.promotion_id AS promotion_promotion_id,
	promotion.promotion_name AS promotion_promotion_name,
	SUM(sf.store_sales) AS revenue,
	SUM(sf.unit_sales) AS unit_sales,
	customer.country as country 	
FROM
	(SELECT * FROM sales_fact_1997 UNION ALL SELECT * FROM sales_fact_1998) sf
	INNER JOIN customer customer ON sf.customer_id = customer.customer_id 
	INNER JOIN promotion promotion ON sf.promotion_id = promotion.promotion_id
	INNER JOIN time_by_day time_by_day ON sf.time_id = time_by_day.time_id
WHERE customer.country = $P{Country} OR 1 = $P{CountryIsNull}
GROUP BY
	customer.country, 	
	promotion.promotion_id,
	promotion.promotion_name
HAVING
	promotion.promotion_name <> 'No Promotion'
ORDER BY
	revenue desc]]>
		</queryString>
		<field name="promotion_promotion_name" class="java.lang.String"/>
		<field name="revenue" class="java.lang.Double"/>
		<field name="promotion_promotion_id" class="java.lang.Integer"/>
		<field name="unit_sales" class="java.lang.Integer"/>
		<variable name="ArrowUp" class="java.lang.Boolean">
			<variableExpression><![CDATA[$F{unit_sales} > 2200]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="Chart Dataset" uuid="f96669a0-b42d-4665-823d-c662493fbfe7">
		<parameter name="promotion_id" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT 
promotion.promotion_name as promotion_promotion_name,
promotion.promotion_id as promotion_promotion_id,
sf.store_sales as revenue
FROM (SELECT * FROM sales_fact_1997 UNION ALL SELECT * FROM sales_fact_1998) sf
INNER JOIN customer customer ON sf.customer_id = customer.customer_id 
INNER JOIN promotion promotion ON sf.promotion_id = promotion.promotion_id 
WHERE sf.promotion_id = $P{promotion_id} 
GROUP BY
	promotion.promotion_id,
	promotion.promotion_name,
	sf.store_sales
HAVING
	promotion.promotion_name <> 'No Promotion'
ORDER BY promotion_promotion_name]]>
		</queryString>
		<field name="promotion_promotion_name" class="java.lang.String"/>
		<field name="revenue" class="java.lang.Double"/>
		<field name="promotion_promotion_id" class="java.lang.Integer"/>
		<group name="promotion_promotion_name">
			<groupExpression><![CDATA[$F{promotion_promotion_name}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="Country" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
		COUNT(*) AS customers, 
		AVG(a.ave_revenue) AS ave_revenue, 
		SUM(a.total_revenue) AS total_revenue, 
		SUM(a.unit_sales) AS unit_sales
FROM
(SELECT 
AVG(sf.store_sales) AS ave_revenue, 
SUM(sf.store_sales) AS total_revenue,
SUM(sf.unit_sales) AS unit_sales 
FROM (SELECT * FROM sales_fact_1997 UNION ALL SELECT * FROM sales_fact_1998) sf
INNER JOIN customer customer ON sf.customer_id = customer.customer_id
GROUP BY customer.customer_id) a]]>
	</queryString>
	<field name="customers" class="java.math.BigDecimal"/>
	<field name="ave_revenue" class="java.lang.Double"/>
	<field name="total_revenue" class="java.lang.Double"/>
	<field name="unit_sales" class="java.lang.Integer"/>
