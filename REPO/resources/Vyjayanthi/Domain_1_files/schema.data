        <item id="Revenue" label="Revenue" resourceId="JoinTree_1.Revenue"></item>
        <item id="currency_id" label="currency_id" resourceId="JoinTree_1.opportunities.currency_id"></item>
      </items>
    </itemGroup>
    <itemGroup id="NewSet4" label="Time Dimensions" resourceId="JoinTree_1">
