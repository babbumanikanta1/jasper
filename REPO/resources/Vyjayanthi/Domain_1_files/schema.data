        <field id="modified_user_id" type="java.lang.String"></field>
        <field id="created_by" type="java.lang.String"></field>
        <field id="title" type="java.lang.String"></field>
        <field id="department" type="java.lang.String"></field>
        <field id="phone_home" type="java.lang.String"></field>
        <field id="phone_mobile" type="java.lang.String"></field>
        <field id="phone_work" type="java.lang.String"></field>
        <field id="phone_other" type="java.lang.String"></field>
