        <field id="messenger_type" type="java.lang.String"></field>
      </fieldList>
    </jdbcTable>
    <jdbcTable id="JoinTree_1" datasourceId="sugarcrmJNDI" datasourceTableName="accounts" schemaAlias="public">
      <fieldList>
        <field id="accounts_opportunities.id" type="java.lang.String"></field>
        <field id="accounts_opportunities.opportunity_id" type="java.lang.String"></field>
        <field id="accounts_opportunities.account_id" type="java.lang.String"></field>
        <field id="accounts_opportunities.date_modified" type="java.sql.Timestamp"></field>
        <field id="accounts_opportunities.deleted" type="java.lang.Short"></field>
