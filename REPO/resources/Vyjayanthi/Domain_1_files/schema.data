        <field id="accounts.sic_code" type="java.lang.String"></field>
        <field id="accounts.ticker_symbol" type="java.lang.String"></field>
        <field id="accounts.shipping_address_street" type="java.lang.String"></field>
        <field id="accounts.shipping_address_city" type="java.lang.String"></field>
        <field id="accounts.shipping_address_state" type="java.lang.String"></field>
        <field id="accounts.shipping_address_postalcode" type="java.lang.String"></field>
        <field id="accounts.shipping_address_country" type="java.lang.String"></field>
        <field id="accounts.deleted" type="java.lang.Short"></field>
        <field id="opportunities.id" type="java.lang.String"></field>
        <field id="opportunities.date_entered" type="java.sql.Timestamp"></field>
        <field id="opportunities.date_modified" type="java.sql.Timestamp"></field>
        <field id="opportunities.modified_user_id" type="java.lang.String"></field>
        <field id="opportunities.assigned_user_id" type="java.lang.String"></field>
        <field id="opportunities.created_by" type="java.lang.String"></field>
        <field id="opportunities.deleted" type="java.lang.Short"></field>
        <field id="opportunities.name" type="java.lang.String"></field>
        <field id="opportunities.opportunity_type" type="java.lang.String"></field>
        <field id="opportunities.lead_source" type="java.lang.String"></field>
        <field id="opportunities.amount" type="java.lang.Double"></field>
        <field id="opportunities.amount_backup" type="java.lang.String"></field>
        <field id="opportunities.amount_usdollar" type="java.lang.Double"></field>
        <field id="opportunities.currency_id" type="java.lang.String"></field>
        <field id="opportunities.date_closed" type="java.util.Date"></field>
        <field id="opportunities.next_step" type="java.lang.String"></field>
        <field id="opportunities.sales_stage" type="java.lang.String"></field>
        <field id="opportunities.probability" type="java.lang.Double"></field>
        <field id="opportunities.description" type="java.lang.String"></field>
        <field id="users.id" type="java.lang.String"></field>
        <field id="users.user_name" type="java.lang.String"></field>
        <field id="users.user_password" type="java.lang.String"></field>
        <field id="users.user_hash" type="java.lang.String"></field>
        <field id="users.first_name" type="java.lang.String"></field>
        <field id="users.last_name" type="java.lang.String"></field>
        <field id="users.reports_to_id" type="java.lang.String"></field>
        <field id="users.is_admin" type="java.lang.String"></field>
        <field id="users.receive_notifications" type="java.lang.String"></field>
        <field id="users.description" type="java.lang.String"></field>
        <field id="users.date_entered" type="java.sql.Timestamp"></field>
        <field id="users.date_modified" type="java.sql.Timestamp"></field>
        <field id="users.modified_user_id" type="java.lang.String"></field>
        <field id="users.created_by" type="java.lang.String"></field>
        <field id="users.title" type="java.lang.String"></field>
        <field id="users.department" type="java.lang.String"></field>
        <field id="users.phone_home" type="java.lang.String"></field>
        <field id="users.phone_mobile" type="java.lang.String"></field>
        <field id="users.phone_work" type="java.lang.String"></field>
        <field id="users.phone_other" type="java.lang.String"></field>
        <field id="users.phone_fax" type="java.lang.String"></field>
        <field id="users.email1" type="java.lang.String"></field>
        <field id="users.email2" type="java.lang.String"></field>
        <field id="users.status" type="java.lang.String"></field>
        <field id="users.address_street" type="java.lang.String"></field>
        <field id="users.address_city" type="java.lang.String"></field>
        <field id="users.address_state" type="java.lang.String"></field>
        <field id="users.address_country" type="java.lang.String"></field>
        <field id="users.address_postalcode" type="java.lang.String"></field>
        <field id="users.user_preferences" type="java.lang.String"></field>
        <field id="users.deleted" type="java.lang.Short"></field>
        <field id="users.portal_only" type="java.lang.Short"></field>
        <field id="users.employee_status" type="java.lang.String"></field>
        <field id="users.messenger_id" type="java.lang.String"></field>
        <field id="users.messenger_type" type="java.lang.String"></field>
        <field id="Quarter" dataSetExpression="concat('Q', toString(quarter(opportunities.date_closed)), '-', toString(year(opportunities.date_closed)))" type="java.lang.String"></field>
        <field id="Revenue" dataSetExpression="opportunities.amount * (opportunities.probability / 100)" type="java.math.BigDecimal"></field>
        <field id="Deal_Age" dataSetExpression="datediff(now(), opportunities.date_entered)" type="java.lang.String"></field>
        <field id="username" dataSetExpression="concat(users.first_name, users.last_name)" type="java.lang.String"></field>
        <field id="deal_size" dataSetExpression="IF(opportunities.amount &gt; 10000, 'Large Deal', IF(opportunities.amount &gt; 5000, 'Medium Deal', 'Small Deal'))" type="java.lang.String"></field>
      </fieldList>
      <joinInfo alias="accounts" referenceId="accounts"></joinInfo>
      <joinList>
        <join expr="accounts.id == accounts_opportunities.id" left="accounts" right="accounts_opportunities" type="inner" weight="1"></join>
        <join expr="accounts_opportunities.opportunity_id == opportunities.id" left="accounts_opportunities" right="opportunities" type="inner" weight="1"></join>
        <join expr="opportunities.assigned_user_id == users.id" left="opportunities" right="users" type="inner" weight="1"></join>
      </joinList>
      <joinOptions></joinOptions>
      <tableRefList>
        <tableRef alwaysIncludeTable="false" tableAlias="accounts" tableId="accounts"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="opportunities" tableId="opportunities"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="accounts_opportunities" tableId="accounts_opportunities"></tableRef>
        <tableRef alwaysIncludeTable="false" tableAlias="users" tableId="users"></tableRef>
      </tableRefList>
    </jdbcTable>
  </resources>
</schema>
