  <itemGroups>
    <itemGroup id="NewSet1" label="Account Info" resourceId="JoinTree_1">
      <items>
        <item id="name" label="name" resourceId="JoinTree_1.accounts.name"></item>
        <item id="billing_address_city" label="billing_address_city" resourceId="JoinTree_1.accounts.billing_address_city"></item>
