      </items>
    </itemGroup>
    <itemGroup id="NewSet2" label="Opportunity Details" resourceId="JoinTree_1">
      <items>
        <item id="name_1" label="name" resourceId="JoinTree_1.opportunities.name"></item>
        <item id="sales_stage" label="sales_stage" resourceId="JoinTree_1.opportunities.sales_stage"></item>
        <item id="lead_source" label="lead_source" resourceId="JoinTree_1.opportunities.lead_source"></item>
        <item id="Deal_Age" label="Deal_Age" resourceId="JoinTree_1.Deal_Age"></item>
      </items>
    </itemGroup>
    <itemGroup id="NewSet3" label="Financials" resourceId="JoinTree_1">
