        <item id="Quarter" label="Quarter" resourceId="JoinTree_1.Quarter"></item>
        <item id="date_entered" label="date_entered" resourceId="JoinTree_1.opportunities.date_entered"></item>
      </items>
    </itemGroup>
  </itemGroups>
