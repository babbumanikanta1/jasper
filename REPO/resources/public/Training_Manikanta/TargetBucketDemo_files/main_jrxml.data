			<property name="com.jaspersoft.studio.field.tree.path" value="region"/>
		</field>
	</subDataset>
	<parameter name="MainParam" class="java.lang.String">
		<defaultValueExpression><![CDATA["USA"]]></defaultValueExpression>
	</parameter>
	<parameter name="Pa" class="java.lang.Long">
		<defaultValueExpression><![CDATA[10]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select  COUNT(sales_city) as total_sales,sales_country
from region
WHERE SALES_COUNTRY not in('No Country')
group by sales_country]]>
	</queryString>
	<field name="total_sales" class="java.lang.Long">
