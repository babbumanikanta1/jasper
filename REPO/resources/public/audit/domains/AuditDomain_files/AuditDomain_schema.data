        <field id="reportExecutionTimeMS" dataSetExpression="parseInteger(value, '######')" type="java.lang.Integer" />
      </fieldList>
      <filterString>property_type == 'reportExecutionTime'</filterString>
    </jdbcTable>
    <jdbcTable id="reportRenderingTime" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditeventproperty" schemaAlias="AuditDataSource_public">
