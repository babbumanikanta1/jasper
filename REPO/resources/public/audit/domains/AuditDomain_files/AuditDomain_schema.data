    <jdbcTable id="jiauditevent" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditevent" schemaAlias="AuditDataSource_public">
      <fieldList>
        <field id="id" type="java.lang.Long" />
        <field id="username" type="java.lang.String" />
        <field id="tenant_id" type="java.lang.String" />
        <field id="event_date" type="java.sql.Timestamp" />
        <field id="resource_uri" type="java.lang.String" />
        <field id="resource_type" type="java.lang.String" />
        <field id="event_type" type="java.lang.String" />
        <field id="request_type" type="java.lang.String" />
        <field id="orguri1" dataSetExpression="if(isNull(resource_uri), NULL, concat('/', substr(resource_uri, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String" />
        <field id="orguri" dataSetExpression="if(startsWith(resource_uri, '/public/'), resource_uri, orguri1)" type="java.lang.String" />
        <field id="filter1" dataSetExpression="(isNull(resource_uri) or contains(resource_uri, constant_fields_level.orgpath) or startsWith(resource_uri, '/public/'))" type="java.lang.Boolean" />
        <field id="filter3" dataSetExpression="(isNull(resource_uri) or not (startsWith(orguri1, '/temp/')))" type="java.lang.Boolean" />
        <field id="au_time" dataSetExpression="parseTime(SUBSTRING(event_date, 12), 'HH:mm:ss')" type="java.sql.Timestamp" />
        <field id="au_date" dataSetExpression="PARSEDATE(event_date, 'yyyy''-''MM''-''dd')" type="java.util.Date" />
      </fieldList>
      <filterString>filter1 == true and filter3 == true</filterString>
    </jdbcTable>
    <jdbcTable id="jiauditevent2" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditevent" schemaAlias="AuditDataSource_public">
      <fieldList>
        <field id="id" type="java.lang.Long" />
        <field id="username" type="java.lang.String" />
        <field id="tenant_id" type="java.lang.String" />
        <field id="event_date" type="java.sql.Timestamp" />
        <field id="resource_uri" type="java.lang.String" />
        <field id="resource_type" type="java.lang.String" />
        <field id="event_type" type="java.lang.String" />
        <field id="request_type" type="java.lang.String" />
        <field id="au_date" dataSetExpression="PARSEDATE(event_date, 'yyyy''-''MM''-''dd')" type="java.util.Date" />
        <field id="au_time" dataSetExpression="parseTime(SUBSTRING(event_date, 12), 'HH:mm:ss')" type="java.sql.Timestamp" />
        <field id="crosstabGroupField" dataSetExpression="'Average Values'" type="java.lang.String" />
        <field id="filter21" dataSetExpression="(isNull(resource_uri) or startsWith(resource_uri, '/public/') or contains(resource_uri, constant_fields_level.orgpath))" type="java.lang.Boolean" />
        <field id="orguri1" dataSetExpression="if(isNull(resource_uri), NULL, concat('/', substr(resource_uri, length(constant_fields_level.orgpath) + 1)))" type="java.lang.String" />
        <field id="orguri" dataSetExpression="if(startsWith(resource_uri, '/public/'), resource_uri, orguri1)" type="java.lang.String" />
        <field id="filter23" dataSetExpression="(isNull(resource_uri) or not (startsWith(orguri1, '/temp/')))" type="java.lang.Boolean" />
      </fieldList>
      <filterString>event_type == 'runReport' and filter21 == true and filter23 == true</filterString>
    </jdbcTable>
    <jdbcTable id="jiauditeventproperty" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditeventproperty" schemaAlias="AuditDataSource_public">
      <fieldList>
        <field id="id" type="java.lang.Long" />
        <field id="property_type" type="java.lang.String" />
        <field id="value" type="java.lang.String" />
        <field id="clob_value" type="java.lang.String" />
        <field id="audit_event_id" type="java.lang.Long" />
      </fieldList>
    </jdbcTable>
    <jdbcTable id="query" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditeventproperty" schemaAlias="AuditDataSource_public">
      <fieldList>
        <field id="id" type="java.lang.Long" />
        <field id="property_type" type="java.lang.String" />
        <field id="value" type="java.lang.String" />
        <field id="clob_value" type="java.lang.String" />
        <field id="audit_event_id" type="java.lang.Long" />
        <field id="queryTypeFilter" dataSetExpression="(property_type == 'sqlQuery' or property_type == 'domainQuery')" type="java.lang.Boolean" />
      </fieldList>
      <filterString>queryTypeFilter == true</filterString>
    </jdbcTable>
    <jdbcTable id="queryExecutionTime" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditeventproperty" schemaAlias="AuditDataSource_public">
      <fieldList>
        <field id="id" type="java.lang.Long" />
        <field id="property_type" type="java.lang.String" />
        <field id="value" type="java.lang.String" />
        <field id="clob_value" type="java.lang.String" />
        <field id="audit_event_id" type="java.lang.Long" />
        <field id="queryExecutionTimeMS" dataSetExpression="parseInteger(value, '######')" type="java.lang.Integer" />
      </fieldList>
      <filterString>property_type == 'queryExecutionTime'</filterString>
    </jdbcTable>
    <jdbcTable id="reportExecutionTime" datasourceId="AuditVirtualDataSource" datasourceTableName="jiauditeventproperty" schemaAlias="AuditDataSource_public">
