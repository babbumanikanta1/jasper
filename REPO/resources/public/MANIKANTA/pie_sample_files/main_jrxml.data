	<parameter name="pp" class="java.util.ArrayList"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    sales_stage,
    ROUND(SUM(amount)::numeric,2) AS total_amount
FROM opportunities
WHERE deleted = 0 and $X{IN, sales_stage,pp}
GROUP BY sales_stage
ORDER BY total_amount DESC;]]>
	</queryString>
	<field name="sales_stage" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="sales_stage"/>
		<property name="com.jaspersoft.studio.field.label" value="sales_stage"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="opportunities"/>
	</field>
	<field name="total_amount" class="java.math.BigDecimal">
