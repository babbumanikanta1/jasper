	<template><![CDATA["repo:Geographic_ReportStyles.jrtx"]]></template>
	<parameter name="Country" class="java.lang.String"/>
	<parameter name="CountryIsNull" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{Country} == null ? 1 : 0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	customer.fullname AS customer_fullname,
	sum(sf.store_sales) AS store_sales,
	customer.customer_id AS customer_id
FROM
	(SELECT * FROM sales_fact_1997 UNION ALL SELECT * FROM sales_fact_1998) sf
	INNER JOIN customer customer ON sf.customer_id = customer.customer_id
	INNER JOIN time_by_day time_by_day ON sf.time_id = time_by_day.time_id
WHERE customer.country = $P{Country} OR 1 = $P{CountryIsNull}
GROUP BY
	customer.customer_id,
	customer.fullname
ORDER BY
	store_sales desc]]>
	</queryString>
	<field name="customer_fullname" class="java.lang.String"/>
	<field name="store_sales" class="java.math.BigDecimal"/>
	<field name="customer_id" class="java.lang.Integer"/>
	<variable name="store_sales" class="java.lang.Integer" calculation="First">
		<variableExpression><![CDATA[$F{store_sales}.intValue()]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
